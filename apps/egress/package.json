{
  "name": "@azx-pbc/egress",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/free-port.mjs ${EGRESS_PORT:-8081} && tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "probe": "node --import tsx src/netprobe.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@azx-pbc/secret-store": "workspace:*",
    "@azx-pbc/shared": "workspace:*",
    "@azx-pbc/telemetry": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "fastify": "catalog:",
    "jose": "catalog:",
    "openid-client": "catalog:",
    "pg": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@azx-pbc/dev-oauth-vendor": "workspace:*",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@types/pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    "./app": "./src/app.ts",
    "./retire": "./src/retire.ts",
    "./providerListener": "./src/providerListener.ts"
  }
}
