{
  "name": "@azx-pbc/portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/free-port.mjs ${PORTAL_PORT:-3001} && tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc",
    "postinstall": "pnpm db:generate",
    "db:generate": "rm -rf src/db/generated && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:azure": "tsx scripts/migrate-deploy.ts",
    "db:reset": "prisma migrate reset --force",
    "seed:llm": "tsx scripts/seed-platform-secret.ts",
    "egress:hosts": "tsx scripts/egress-hosts.ts",
    "geo:fetch": "node src/geo/fetchDb.ts",
    "db:backfill-owners": "tsx scripts/backfill-app-owners.ts",
    "db:backfill-user-labels": "tsx scripts/backfill-user-labels.ts"
  },
  "dependencies": {
    "@azure/identity": "catalog:",
    "@azure/storage-blob": "catalog:",
    "@azx-pbc/deploy-skill": "workspace:*",
    "@azx-pbc/directory": "workspace:*",
    "@azx-pbc/secret-store": "workspace:*",
    "@azx-pbc/shared": "workspace:*",
    "@azx-pbc/telemetry": "workspace:*",
    "@fastify/multipart": "catalog:",
    "@fastify/static": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "jose": "catalog:",
    "mmdb-lib": "catalog:",
    "pg": "catalog:",
    "yauzl": "catalog:",
    "zod": "catalog:"
  },
  "exports": {
    "./app": "./src/app.ts",
    "./db-client": "./src/db/client.ts",
    "./internal-jwt": "./src/internalJwt.ts",
    "./test-harness": "./src/test/harness.ts"
  },
  "devDependencies": {
    "@azx-pbc/dev-idp": "workspace:*",
    "@azx-pbc/dev-oauth-vendor": "workspace:*",
    "@azx-pbc/egress": "workspace:*",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@types/archiver": "catalog:",
    "@types/pg": "catalog:",
    "@types/yauzl": "catalog:",
    "archiver": "catalog:",
    "form-data": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
