// Helix control-plane registry — the source of truth (architecture §7).
// The portal owns this schema and all migrations; the edge never writes and
// hand-writes SQL against a cached projection (project plan §1, §6).
//
// Models map 1:1 onto the @azx-pbc/shared zod schemas (App, Version) — the DB is
// the source of truth for shape, zod validates the API boundary, and a thin
// mapper (src/db/mappers.ts) bridges the two. Enum values are kept identical to
// VERSION_STATUSES / VISIBILITY_MODES in @azx-pbc/shared (a test asserts this).

generator client {
  // Prisma 7's Rust-engine-free client. ESM output, generated into the package
  // so imports use explicit .js specifiers under nodenext.
  provider            = "prisma-client"
  output              = "../src/db/generated"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  // Prisma 7: the connection URL lives in prisma.config.ts (for Migrate) and is
  // supplied at runtime via the pg driver adapter in src/db/client.ts.
  provider = "postgresql"
}

enum VersionStatus {
  preview
  live
  archived
}

enum VisibilityMode {
  internal
  group
  password
  public
}

/// A registered app. `slug` is the subdomain label and the isolation boundary.
/// `currentVersionId` is the live pointer — null before the first promote;
/// "deploy" flips it, "rollback" flips it back (architecture §4.3).
model App {
  id                 String            @id @default(uuid()) @db.Uuid
  slug               String            @unique
  displayName        String
  /// What the app is for, in one sentence. Plain text — the cap (500) lives in
  /// zod (`AppSchema.description`), not here, so re-tuning it needs no
  /// migration. Nullable: rows predating the field carry none, and it is
  /// omitted from the wire rather than sent as null.
  description        String?
  /// Creator's `actor.oid` — the Entra `oid` claim (ADR-0048), set at
  /// `app.create`. Nullable: rows predating the approvals work
  /// (docs/design/approvals.md §4) have no recorded owner; rows created before
  /// the ADR-0048 re-base hold the old email-collapsed subject until the
  /// cutover runbook rewrites them. Drives the admin queue "owner" column,
  /// "who may request/withdraw", and the apps list's `scope=mine` filter.
  /// **The identity half — compared, never rendered.** It is the one id the
  /// edge session also holds for the same human.
  ownerId            String?
  /// The owner's claims as they read at `app.create` (`actor.name`/`actor.email`).
  /// **The display half — rendered, never compared.** Stored rather than resolved
  /// because `ownerId` is the opaque directory object id (ADR-0048), which names
  /// nobody the platform can resolve — it holds no Graph `/users` grant
  /// (ADR-0040 decision 3). These columns keep every owner cell in the portal
  /// readable. Slightly stale if someone renames themselves in the directory;
  /// nullable for rows predating them (a transitional backfill migration
  /// captured the email from the pre-re-base `ownerId` where it was still one).
  ownerName          String?
  ownerEmail         String?
  // Visibility is a discriminated union in zod; stored flattened here so it is
  // queryable/indexable (only `group` carries a payload).
  visibilityMode     VisibilityMode
  /// Any-of group ids for `group` visibility; empty for every other mode, and
  /// empty is also a legal (deny-everyone) `group` state. Cap lives in zod
  /// (`MAX_VISIBILITY_GROUPS`), not here — an array needs no migration to
  /// re-tune it (ADR-0040 §5).
  visibilityGroupIds String[]
  // Shared-password credential for `password` visibility (docs/features/
  // authentication.md). `passwordHash`/`passwordSalt` (scrypt) are PROJECTED to
  // the edge to verify a login; `passwordEnc` (AES-256-GCM) is portal-only —
  // decryptable here so the owner can re-display/copy the cleartext, never read
  // by the edge. All null unless visibility is `password`.
  passwordHash       String?
  passwordSalt       String?
  passwordEnc        String?
  passwordSetAt      DateTime?
  // The live version pointer. One-to-one with Version; SetNull so deleting a
  // version (only via app cascade in practice) can't dangle the pointer.
  currentVersionId   String?           @unique @db.Uuid
  currentVersion     Version?          @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions           Version[]         @relation("AppVersions")
  sessions           Session[]
  approvalRequests   ApprovalRequest[]
  /// Secrets owned by this app (`scope = 'app'`); global secrets have no owner.
  secrets            AppSecret[]
  /// Grants of `global` secrets to this app (the consuming side).
  grantedSecrets     AppSecretGrant[]
  /// Dev-mode tokens for developing this app against its env=dev partition (§4).
  devTokens          AppDevToken[]
  /// Per-app capability manifest (architecture §6.3) — what the gateway grants
  /// and enforces. JSON matches @azx-pbc/shared `CapabilitiesSchema`; the edge
  /// reads it through the registry projection. Defaults to the baseline (no
  /// capabilities). Manifest versioning/approvals are a v1 control-plane feature.
  capabilities       Json              @default("{}")
  /// Optimistic-concurrency guard over the **effective policy state** — the
  /// `capabilities` blob plus the two `visibility*` columns (docs/design/
  /// approvals.md §5). Every path that reads those columns and writes them back
  /// compare-and-swaps on the value it read and bumps it, so two writers cannot
  /// silently lose each other's change; the loser gets a 409. Not projected to
  /// the edge — it exists only to serialise control-plane writes.
  policyVersion      Int               @default(0)
  /// Archived apps return 410 + Clear-Site-Data at the edge (architecture §7).
  archivedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("apps")
}

/// An immutable deploy. Assets live in Blob under `blobPrefix`
/// (`apps/<appId>/<number>/`). `number` is per-app monotonic, 1-based.
model Version {
  id            String        @id @default(uuid()) @db.Uuid
  appId         String        @db.Uuid
  app           App           @relation("AppVersions", fields: [appId], references: [id], onDelete: Cascade)
  number        Int
  blobPrefix    String
  status        VersionStatus @default(preview)
  createdAt     DateTime      @default(now())
  // Client-asserted salvage provenance (ADR-0038): what the portal SPA did to the
  // upload before sending it. Never verified, never read for policy/serving — it
  // only explains why this version's file list looks the way it does.
  deployReport  Json?
  // Back-relation for the live pointer (the app, if any, currently serving this).
  currentForApp App?          @relation("CurrentVersion")

  @@unique([appId, number])
  @@index([appId, status])
  @@map("versions")
}

/// App-user session state (architecture Appendix A.4) — **edge-owned data**.
/// The edge is the sole writer (hand-written SQL, apps/edge/src/auth/sessions.ts):
/// it mints, redeems, refreshes and sweeps these rows. The portal's two
/// operations are the admin Sessions screen — read live rows (SELECT) and the
/// user-level revoke (DELETE, migration 20260921120000 revoked INSERT/UPDATE so
/// the control plane can never mint or rebind a session). The handoff's atomic
/// redeem UPDATE is edge-only **by grant**, not just by convention.
///
/// `id` doubles as the handoff token's `jti`; `tokenHash` (sha256 of the
/// cookie value, so a DB read-leak never yields usable cookies) is NULL while
/// the handoff is minted but not yet redeemed. Redemption binds it atomically
/// — that UPDATE is what makes the handoff single-use.
model Session {
  id           String    @id @db.Uuid
  tokenHash    String?   @unique
  appId        String    @db.Uuid
  app          App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  userOid      String
  displayName  String
  /// The captured directory claims, as they read at login. Distinct from
  /// `displayName` on purpose: that is the `/_api/me` contract value (non-null,
  /// with a fallback ladder, and platform-minted "Guest" for a shared-password
  /// visitor), whereas these are the claims themselves and are null when the IdP
  /// sent none. They coincide for an ordinary SSO login and diverge exactly where
  /// it matters, which is why one is not derived from the other.
  userName     String?
  /// Which code path minted this principal: `user` | `password` | `dev`
  /// (`PRINCIPAL_KINDS` in `@azx-pbc/shared`). Carried so the edge does not have
  /// to re-derive it from `userOid`'s shape after a lookup — see the migration.
  userKind     String?
  /// The email/UPN claim as it read at login (`email ?? preferred_username`).
  /// **Display half — rendered, never compared**, exactly like `App.ownerEmail`.
  /// Captured so the gateway ledger and collection rows can carry an attributable
  /// label; `displayName` alone cannot disambiguate two people with one name.
  /// Null for shared-password, anonymous and dev-token principals, and for every
  /// row predating the column. **Never exposed to app code** — `GET /_api/me`
  /// returns `{id, displayName}` only (`packages/shared/src/auth.ts`).
  userEmail    String?
  /// Group-id snapshot at login/refresh (refresh re-evaluates membership).
  groups       Json      @default("[]")
  createdAt    DateTime  @default(now())
  activatedAt  DateTime?
  /// Silent re-auth (prompt=none) is due after this instant.
  refreshDueAt DateTime
  /// Hard cap — the session is dead regardless of activity.
  expiresAt    DateTime

  @@index([expiresAt])
  @@map("sessions")
}

/// Append-only deploy/registry events. `actor` is the authenticated subject
/// (M1: the dev-token actor; M3 swaps the source, not the shape).
model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  appId     String?  @db.Uuid
  actor     String
  action    String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([appId, createdAt])
  @@map("audit_events")
}

/// A typed, pending change to an app's effective policy, awaiting a privileged
/// decision (docs/design/approvals.md §2). The `apps` row holds only effective
/// state; "requested state" is the set of open rows here. On approve, `deltas`
/// are applied to the `apps` columns in one txn and the row is closed — the edge
/// only ever sees the resulting effective-state change via the registry trigger,
/// never this table (it has no grant on it).
model ApprovalRequest {
  id    String @id @default(uuid()) @db.Uuid
  appId String @db.Uuid
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  /// pending | approved | denied | withdrawn | needs_changes (@azx-pbc/shared APPROVAL_STATUSES).
  status       String
  /// low | med | high — max risk across the deltas; stored for queue sort.
  risk         String
  /// The *elevated* subset of a change: typed Delta[] (@azx-pbc/shared §3).
  deltas       Json
  /// Effective values of the touched areas at request time (conflict detect + diff render).
  baseSnapshot Json

  /// The requester's **identity half** — their Entra `oid` (ADR-0048). What
  /// the separation-of-duty guards (approve/deny/needs_changes) and the
  /// withdraw gate compare; `actor.oid` at request time. Nullable only on
  /// rows predating the re-base — null fails closed in every guard that
  /// reads it, and the cutover runbook rewrites pending rows from the same
  /// email→oid pairs as `apps.ownerId`.
  requestedOid String?
  /// The requester's **display half** (`actor.sub`, usually their email) —
  /// rendered in the queue, stored on the audit event, never compared.
  requestedBy  String
  reason       String?
  /// The deciding admin's display half, when decided — display/audit only,
  /// nothing compares it.
  decidedBy    String?
  /// Required on deny / needs_changes.
  decisionNote String?

  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([status, createdAt]) // the admin queue
  @@index([appId]) // the app-detail "pending" banner
  @@map("approval_requests")
}

/// Per-call gateway ledger (architecture §6.1/§6.3, §8) — metering + audit for
/// every `/_api/*` capability use: (app, user, capability, model, tokens,
/// outcome). **Edge-written data**, like `sessions`: only the edge INSERTs (one
/// row per call) and SUMs today's tokens for the per-app daily budget, via
/// hand-written SQL (apps/edge/src/gateway/usage.ts). The portal owns the schema
/// and **reads** it for display (usage tab, audit log, platform rollups —
/// apps/portal/src/routes/usage.ts) but never writes — `helix_portal` is
/// SELECT-only here (append-only for every writer role; ADR-0021 / issue #17,
/// migration 20260721120000_gateway_calls_portal_readonly). No FK to `apps` (mirrors
/// AuditEvent) — the ledger outlives any single app row, so reads left-join the
/// slug and tolerate its absence.
model GatewayCall {
  id                       String   @id @default(uuid()) @db.Uuid
  appId                    String   @db.Uuid
  /// Partition tier (dev-mode design §5.1): 'prod' | 'dev'. Makes budgets/usage
  /// naturally per-env — the env-literal RLS (§5.3) scopes every SUM to one tier.
  env                      String   @default("prod")
  userOid                  String
  /// The caller's claims as they read when the call was made. **Display half —
  /// rendered, never compared** (the identity is `userOid`), mirroring the
  /// `App.ownerName`/`ownerEmail` split. Captured rather than resolved: `userOid`
  /// is the Entra `oid` claim (ADR-0048) — or a pairwise `sub` on rows that
  /// predate the re-base — and the platform holds no Graph `/users` grant, so
  /// it resolves to nobody by policy, and the only id→name map
  /// in the system (`sessions`) is swept at expiry while these rows are
  /// append-only. Null for `anon`, `pw_*` and dev-token callers, and for rows
  /// predating the columns — the portal falls back to rendering `userOid`.
  userName                 String?
  userEmail                String?
  /// The principal's kind (`PRINCIPAL_KINDS`): `user` | `password` | `anon` |
  /// `dev`. Written at capture because it cannot be soundly inferred —
  /// pre-re-base `userOid` rows carry Entra's `sub`, which shares the base64url
  /// alphabet with the `pw_` pseudonym prefix, so a shape test mislabels ~1
  /// legacy subject in 262,144. Null on rows predating it.
  userKind                 String?
  /// Capability invoked — `llm` in M4.
  capability               String
  /// Model the request asked for (post-allowlist).
  model                    String
  inputTokens              Int      @default(0)
  outputTokens             Int      @default(0)
  /// Cache-aware input accounting (Anthropic prices these differently: read
  /// ~0.1x, write 1.25x). Always 0 until prompt caching is enabled, but captured
  /// now so dollar math is correct the day it flips on.
  cacheReadInputTokens     Int      @default(0)
  cacheCreationInputTokens Int      @default(0)
  /// Frozen as-charged cost of this call in **micro-USD** (1e-6 USD), priced by
  /// the edge at write time via `@azx-pbc/shared` (`costUsd`). Integer for exact
  /// SUMs. This is the source of truth for both the per-app USD spend gate (a
  /// daily + rolling-hour window in apps/edge/src/gateway/usage.ts) and every
  /// dollar figure the portal displays — token columns stay so cost is always
  /// re-derivable if rates are corrected. 0 for non-LLM and quota-blocked rows.
  costMicroUsd             BigInt   @default(0)
  /// `ok` | `error` | `refusal` | `quota_blocked` | `conflict` | `forbidden`.
  /// Plain TEXT, not an enum — `GATEWAY_OUTCOMES` in `@azx-pbc/shared` is the
  /// source of truth, and the edge imports its union from there.
  outcome                  String
  /// Upstream round-trip latency in ms (0 when not measured).
  durationMs               Int      @default(0)
  /// Upstream/egress HTTP status — meaningful for `fetch`; null for streamed `llm`.
  statusCode               Int?
  /// LLM stop reason (`end_turn` | `max_tokens` | `refusal` | …); null for non-LLM.
  stopReason               String?
  /// Short, truncated upstream error string; null on success.
  errorDetail              String?
  /// Request path of a proxied call — set for `fetch`; null otherwise. The
  /// target's query string is excluded (`redactFetchTarget` in
  /// `@azx-pbc/shared/logging` draws the same line for logs) because that is
  /// where credentials are conventionally placed. That does NOT make this column
  /// credential-free: some APIs put the secret in a path segment, and no
  /// heuristic tries to spot one — a token segment and a REST resource id are
  /// the same shape. The edge caps the length at write time (the value is
  /// app-controlled and no role holds DELETE here); retention is the real
  /// mitigation. See ADR-0021 and apps/edge/src/gateway/usage.ts.
  path                     String?
  /// HTTP method of a proxied call — set for `fetch`; null otherwise.
  method                   String?
  createdAt                DateTime @default(now())

  /// Per-app windowed reads (edge budget + portal usage tab) and the audit
  /// cursor — env-partitioned so per-tier budget SUMs hit the index.
  @@index([appId, env, createdAt])
  /// Platform-wide rollups (architecture §8) scan by time across all apps.
  @@index([createdAt])
  @@map("gateway_calls")
}

/// Fixed-window counters for the edge's abuse controls — the anonymous IP rate
/// limiter and the shared-password login throttle (issue #13, ADR-0011/0004).
/// **Edge-written data**: the edge does one atomic INSERT … ON CONFLICT upsert
/// per admission (apps/edge/src/gateway/counterStore.ts), so the limit holds
/// across replicas instead of degrading to N× per-process (the old in-memory
/// Maps). `bucketKey` is namespaced by purpose + client, e.g. `anon:<ip>:<appId>`
/// / `login:<ip>:<appId>`; `resetAt` is the window edge (a GC sweep drops elapsed
/// rows). `helix_portal` is carved out to no-write like `gateway_calls`.
model RateCounter {
  /// `<purpose>:<ip>:<appId>` — purpose-namespaced so both limiters share one table.
  bucketKey String   @id
  count     Int
  /// Window boundary; the counter resets once now() passes it.
  resetAt   DateTime

  @@index([resetAt])
  @@map("rate_counters")
}

/// Fixed-window abuse counters owned by the **control plane** (ADR-0040 §4).
///
/// Same three columns as `rate_counters`, and deliberately NOT that table.
/// `rate_counters` is shared by the edge, which keys the shared-password login
/// throttle (`auth/loginThrottle.ts`) and the anonymous IP limiter
/// (`ipRateLimiter.ts`) in it; migration 20260721215912 revoked the portal's
/// writes there. Granting them back would hand the control plane — or a portal
/// RCE — the ability to zero the edge's brute-force protection, and Postgres
/// cannot scope a grant by key prefix (RLS is deliberately off that hot path).
/// A second table costs one migration and keeps the two planes' abuse-control
/// state disjoint.
model PortalRateCounter {
  /// Namespaced by purpose + actor, e.g. `dirsearch:<actor.sub>`.
  bucketKey String   @id
  count     Int
  resetAt   DateTime

  @@index([resetAt])
  @@map("portal_rate_counters")
}

/// One-time-use burn set for the attested instruction the edge mints for egress
/// (ADR-0013 Step 1, issue #3). **Egress-written data**: egress does one atomic
/// INSERT … ON CONFLICT DO NOTHING per proxied call (apps/egress/src/burn.ts) —
/// `rowCount === 0` means the `jti` was already spent, i.e. a replay, and the
/// call is refused. Global (a `jti` is unique regardless of app); rows are
/// short-lived (~instruction TTL + clock tolerance) and a GC sweep drops expired
/// ones. `helix_egress` fully manages it (SELECT+INSERT+DELETE — its first write
/// grants); `helix_portal` is carved out to read-only.
model InstructionJti {
  /// The instruction's `jti` (== its per-call `requestId`).
  jti       String   @id
  /// Retention floor ≥ maxTokenAge + clockTolerance + margin; swept after this.
  expiresAt DateTime

  @@index([expiresAt])
  @@map("instruction_jti")
}

/// In-flight call leases behind the edge's per-app and per-user concurrency caps. **Edge-written
/// data**: the edge inserts one row per scope per admitted call (apps/edge/src/gateway/leaseStore.ts)
/// and deletes them when the call ends. A row also expires at `expiresAt`, so a replica that dies
/// leaks a slot only until then. No RLS: `scope` embeds the app id, the way rate_counters keys
/// do. `helix_edge` has SELECT+INSERT+DELETE; every other role is carved out.
model InflightLease {
  id        String   @db.Uuid
  scope     String
  expiresAt DateTime

  @@id([id, scope])
  @@index([scope, expiresAt])
  @@map("inflight_leases")
}

/// Per-user / per-app key-value store (architecture §6.1, app-data design
/// §3.1/§3.3). **Edge-written data**, like sessions/gateway_calls: the edge
/// reads & writes ONLY rows whose partition key is the caller's own
/// (appId[, userOid]) — enforced by a hand-written WHERE AND by row-level
/// security (the migration's `app_data_partition` policy, set per request from
/// the verified session via SET LOCAL). The SELECT-all path does not exist for
/// the edge role. JSONB value, app-supplied. No FK to `apps` (mirrors
/// GatewayCall) so the data outlives an app row; the edge supplies
/// `gen_random_uuid()` in raw SQL.
model AppData {
  id        String   @id @default(uuid()) @db.Uuid
  appId     String   @db.Uuid
  /// Partition tier (dev-mode design §5.1): 'prod' | 'dev'. Part of the partition
  /// key and pinned per-role by the env-literal RLS policies (§5.3).
  env       String   @default("prod")
  /// null = app-shared (§3.3); non-null = the owning user (§3.1).
  userOid   String?
  key       String
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
  /// Opaque optimistic-concurrency token (ADR-0041): starts at 1, incremented by
  /// every write, CAS'd by `If-Match` on the data plane. BIGINT on purpose —
  /// node-postgres hands it back as a string, which is what an opaque ETag
  /// should be: no Number precision question, no formatting step where the
  /// token can lose fidelity (the bug class that disqualified updatedAt).
  /// NOT delete-safe: the counter is per row, so delete + recreate restarts at
  /// 1 and a stale `If-Match: "1"` would match a value it never read (ABA).
  /// Acceptable while DELETE is user-scope-only (one person's own tabs);
  /// revisit — e.g. a row-birth nonce folded into the ETag — before any shared
  /// delete verb lands.
  version   BigInt   @default(1)

  /// One row per (app, env, user-or-shared, key); the gateway's partition is unique.
  @@unique([appId, env, userOid, key])
  @@map("app_data")
}

/// Append-only collection items (app-data design §3.2) — write-from-edge,
/// read-from-portal. The asymmetry is a database-privilege split: the edge role
/// has INSERT only (no SELECT/DELETE), so a compromised edge or a malicious app
/// can add rows but can NEVER enumerate them; the owner-facing read/export/
/// delete path runs on the privileged portal role. The migration's grants are
/// the security property — there is no RLS here because there is no read to
/// scope. No FK to `apps` (mirrors GatewayCall); the edge supplies
/// `gen_random_uuid()` in raw SQL.
model AppCollectionItem {
  id         String   @id @default(uuid()) @db.Uuid
  appId      String   @db.Uuid
  /// Partition tier (dev-mode design §5.1): 'prod' | 'dev'. Env-literal RLS (§5.3).
  env        String   @default("prod")
  collection String
  /// The visitor who submitted, if authenticated; null on public/anon apps (§6).
  userOid    String?
  /// The submitter's captured claims — **display half, never compared**; see
  /// `GatewayCall.userName`. Null whenever `userOid` is (anonymous submissions)
  /// and for password/dev-token principals. Surfaced in the owner's drain UI and
  /// as columns 5-6 of the CSV export.
  userName   String?
  userEmail  String?
  /// The submitter's kind (`PRINCIPAL_KINDS`); null whenever `userOid` is, and on
  /// rows predating the column. See `GatewayCall.userKind`.
  userKind   String?
  item       Json
  /// Coarse abuse-triage metadata (hashed IP, UA) — never exposed to the app.
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([appId, env, collection, createdAt])
  @@map("app_collection_items")
}

/// CSP violation reports (docs/design/approvals.md §6.2) — write-from-edge,
/// read-from-portal, exactly like `app_collection_items`. The browser POSTs a
/// violation to the edge's same-origin `/_csp-report` sink; the edge appends a
/// row (INSERT-only grant — it can never enumerate them) and the portal reads
/// them to surface the Violations screen, which feeds one-click origin-grant
/// approval requests. No FK to `apps` (mirrors GatewayCall) — reports outlive an
/// app row; the edge supplies `gen_random_uuid()` in raw SQL.
model CspReport {
  id          String   @id @default(uuid()) @db.Uuid
  appId       String   @db.Uuid
  /// The violated directive (e.g. `connect-src`).
  directive   String
  /// The blocked origin/URL the app tried to reach.
  blockedUri  String
  /// The document the violation occurred on, when reported.
  documentUri String?
  createdAt   DateTime @default(now())

  @@index([appId, createdAt])
  @@map("csp_reports")
}

/// Hosted-app page loads for the owner's Visitors view (ADR-0050). The edge
/// appends one row per top-level HTML document it serves past the session gate
/// (INSERT-only grant, `app.app_id` RLS); the portal aggregates them and deletes
/// rows past the retention window. A row never holds a raw IP, a user identity,
/// a path, or a user agent. No FK to `apps` (mirrors GatewayCall).
model AppVisit {
  id          String   @id @default(uuid()) @db.Uuid
  appId       String   @db.Uuid
  /// Partition tier; only the prod edge records visits today.
  env         String   @default("prod")
  /// Keyed HMAC of `appId|ip` (32 hex). Stable per app, so it counts unique
  /// visitors across the window; null when the edge has no auth secret to key it.
  visitorHash String?
  /// The client IP truncated to /24 (IPv4) or /48 (IPv6) — enough for a coarse
  /// geo lookup, not enough to name a host. Null when the edge saw no IP.
  ipPrefix    String?
  createdAt   DateTime @default(now())

  @@index([appId, env, createdAt])
  @@map("app_visits")
}

/// Connection secrets (docs/design/secrets-and-connections.md). Third-party
/// credentials the platform holds so an app never does. **Control-plane data**:
/// the portal writes them (CRUD + rotation), the separate `azx-egress` service
/// (role `helix_egress`) reads `material` to inject server-side, and the policy
/// edge (`helix_edge`) has NO grant here at all — that absence is the boundary.
///
/// `material` is the only credential-bearing column: dev holds AES-256-GCM
/// ciphertext, prod a Key Vault reference — never plaintext, never re-displayed
/// (write-only / rotate-only, §3). `scope` is `app` (owning `appId` set) or
/// `global` (`appId` null, usable only via `AppSecretGrant`). `@@unique([appId,
/// env, name])` covers the app-scoped case; the admin scopes carry `appId` NULL,
/// which Postgres treats as distinct, so they are covered by a **raw** partial
/// unique index — `app_secrets_admin_scope_name_key`, migration
/// 20260730001500_app_secrets_admin_scope_unique (not expressible here). The
/// route's pre-check remains as a friendly 409; the index is what makes it safe
/// under concurrency, because `seal()` writes to the vault before the row exists.
model AppSecret {
  id         String           @id @default(uuid()) @db.Uuid
  scope      String
  appId      String?          @db.Uuid
  app        App?             @relation(fields: [appId], references: [id], onDelete: Cascade)
  /// Partition tier (dev-mode design §6): 'prod' | 'dev'. A dev fetch resolves
  /// only dev connection secrets and vice-versa; egress scopes resolution by the
  /// env carried in the attested instruction. `platform` (LLM vendor) secrets are
  /// resolved by name only and are env-agnostic.
  env        String           @default("prod")
  name       String
  material   String
  /// @azx-pbc/shared InjectionRecipe — how the resolved secret is applied outbound.
  injection  Json
  createdBy  String
  createdAt  DateTime         @default(now())
  rotatedAt  DateTime?
  /// Stamped by the egress service on each successful injection (stale report, §6).
  lastUsedAt DateTime?
  grants     AppSecretGrant[]

  @@unique([appId, env, name])
  @@map("app_secrets")
}

/// Grant of a `global` secret to a specific app (secrets design §2/§7). Both
/// sides must be true for an app to spend a global secret: this grant row AND a
/// manifest connection binding. Admin-only and approval-gated to create.
model AppSecretGrant {
  secretId  String    @db.Uuid
  secret    AppSecret @relation(fields: [secretId], references: [id], onDelete: Cascade)
  appId     String    @db.Uuid
  app       App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  grantedBy String
  createdAt DateTime  @default(now())

  @@id([secretId, appId])
  @@index([appId])
  @@map("app_secret_grants")
}

/// An administrator-configured vendor OAuth registration — one vendor
/// integration in one environment. `ref` is the stable,
/// human-readable key manifests/catalogue/imports use (env-unique, immutable);
/// `id` is the surrogate everything inside the platform joins on; `revision`
/// starts at 1 and advances on every sensitive mutation and delete — one field
/// serving admin concurrency (the edit route's CAS), cache invalidation (the
/// NOTIFY channel, ADR-0011) and consent staleness (rows recorded against a
/// stale revision conflict). Shape is `@azx-pbc/shared ConnectionProviderSchema`.
///
/// `clientIdMaterial`/`clientSecretMaterial` are **sealed material** — the
/// opaque token the portal's SecretStore `seal()` produces (dev AES-GCM
/// envelope / prod Key Vault reference), following `AppSecret.material`'s
/// convention; never plaintext, never returned by any read. Egress opens them
/// (its SELECT grant + the delegated vault) to build the vendor OAuth client.
///
/// No model relation to anything: deleting a provider (hard DELETE, portal
/// role) must leave connections and attempts dangling against a nonexistent
/// id — delete+recreate under the same `ref` mints a new `id` and restores
/// nothing (ADR-0004) — so `user_connections`/`connection_consent_attempts`
/// carry a bare `providerId` column, no FK (the `GatewayCall`→`App` precedent:
/// the referencing rows outlive the referenced one by design).
model ConnectionProvider {
  id                  String   @id @default(uuid()) @db.Uuid
  /// Env-unique stable reference (`@@unique([ref, env])`); immutable after create.
  ref                 String
  /// `PROVIDER_KINDS` in @azx-pbc/shared — `rest-delegated` only at first commit.
  kind                String
  displayName         String
  authorizeEndpoint   String
  tokenEndpoint       String
  /// RFC 6749 §3.3 scope tokens requested at authorize time (may be empty).
  requestedScopes     Json
  /// Canonical API destinations (`scheme://host[:port]`) the binding may call.
  apiOrigins          Json
  /// @azx-pbc/shared TokenPlacement — how the user's delegated token is
  /// presented outbound (`header-bearer` or a named `header`).
  tokenPlacement      Json
  /// Partition tier (dev-mode §5.1): 'prod' | 'dev'. Client credentials are
  /// per-tier (criterion 5); the env-literal RLS policy + env CHECK pin the row.
  env                 String   @default("prod")
  clientIdMaterial    String
  clientSecretMaterial String
  /// ADR-0004 — bumped on every sensitive mutation and delete; consumers
  /// stamp it at consent/approval filing and compare it at resolution.
  revision            Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([ref, env])
  @@map("connection_providers")
}

/// One user's consent to one provider in one environment — keyed
/// `(userOid, providerId, env)`, platform-wide: every approved app reuses it
/// (clarifications Q2/Q10). Written by BOTH planes: the portal (callback save
/// as a CAS upsert, invalidation, disconnect) and egress (renewal outcomes:
/// material swap + expiry + ledger, reconnect-needed) — which is why the row
/// shape is the @azx-pbc/shared `UserConnectionSchema` zod contract, the single
/// definition every writer and reader parses (ADR-0006 §Shared ground).
///
/// `material` is **sealed** (AppSecret.material's convention): the opaque
/// `SecretStore.seal()` token holding the access + refresh material. Only
/// egress opens it; the portal reads/writes the row without plaintext access.
/// `providerRevision` stamps the provider row's revision at consent (ADR-0004).
///
/// The renewal/retirement ledger (ADR-0008) lives in-row: a material swap
/// writes the OLD sealed reference into `pendingRetire` in the same UPDATE —
/// egress's sweep claims it by CAS (`WHERE "pendingRetire" = X`) before
/// destroying the vault entry, so a racing reconnect can never lose new
/// material. `renewBeforeNext` is criterion 40's flag: set after a pre-expiry
/// vendor 401 so the next call renews first.
///
/// No FK to `connection_providers` (see ConnectionProvider): provider deletion
/// invalidates the rows (status flips to `invalidated` in the same portal
/// transaction) but the rows dangle, not vanish. No FK to `apps` either —
/// a connection is platform-wide, not per-app.
model UserConnection {
  id               String    @id @default(uuid()) @db.Uuid
  /// The consenting principal (`actor.oid`; a dev-token caller's
  /// `developerOid` in the dev tier, Q10). Compared and joined on, never
  /// rendered — the display halves resolve portal-side.
  userOid          String
  providerId       String    @db.Uuid
  /// The provider row's revision at consent (ADR-0004) — a sensitive edit
  /// invalidates the row, so a stale stamp fails closed at resolution.
  providerRevision Int
  /// Partition tier: 'prod' | 'dev'. Env-literal RLS + env CHECK pin it;
  /// dev and prod connections never see each other (criterion 5).
  env              String    @default("prod")
  /// `CONNECTION_STATUSES` in @azx-pbc/shared: 'live' | 'reconnect-needed' |
  /// 'invalidated' — a DB CHECK mirrors the bounded vocabulary (fail closed).
  status           String
  /// Sealed access + refresh material (SecretStore output — never plaintext).
  material         String
  /// The scopes the vendor actually granted (superset checks at consult).
  grantedScopes    Json
  grantedAt        DateTime  @default(now())
  /// Access-token expiry; egress renews when a call lands past it (criterion 35).
  expiresAt        DateTime
  /// Criterion 40 — a pre-expiry vendor 401 demands renewal before the next call.
  renewBeforeNext  Boolean   @default(false)
  /// ADR-0008's in-row retirement ledger: the old sealed reference awaiting
  /// the egress sweep's conditional destroy; NULL once claimed and destroyed.
  pendingRetire    String?
  /// Last successful egress renewal (the renewal half of the in-row ledger).
  lastRenewedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /// The connection partition key — one row per (user, provider, env).
  @@unique([userOid, providerId, env])
  /// The retirement sweep's claim scan (`WHERE "pendingRetire" IS NOT NULL`).
  @@index([pendingRetire])
  @@map("user_connections")
}

/// One pending consent attempt — the control-plane-owned consent-flow state
/// (ADR-0031 amendment item 6): the portal's consult writes it, the callback claims it
/// (single-use redeem pattern), the helper's cancel marks it, the portal sweep
/// drops expired rows. Field list is ADR-0002's fixed list: state, PKCE
/// verifier, identity, provider id+revision, app, env, opener origin,
/// five-minute TTL — plus the dev journey's single-use nonce (ADR-0002
/// §Implementation Notes) and `cancelledAt`, the marker a late completion
/// tests so a cancelled attempt can never be claimed.
///
/// No FKs (the ConnectionProvider precedent): attempts outlive mid-flow
/// provider/app deletion and fail closed at claim; the five-minute sweep
/// retires them regardless. Portal-role only — `helix_edge` holds no grant
/// (it consults over HTTP; the strictest role split the platform has).
model ConnectionConsentAttempt {
  id               String    @id @default(uuid()) @db.Uuid
  /// The OAuth `state` parameter — the callback's lookup key (unique, single-use).
  state            String    @unique
  /// PKCE code verifier generated at consult; redeemed against the vendor at claim.
  codeVerifier     String
  /// The verified caller identity (`userOid`; the dev gateway's
  /// `developerOid` in the dev tier) — captured, never a request input.
  userOid          String
  providerId       String    @db.Uuid
  /// The provider row's revision at attempt time (ADR-0004) — completion
  /// against a since-edited provider fails closed.
  providerRevision Int
  /// The app the consent started from — the consult checked its binding.
  appId            String    @db.Uuid
  /// Partition tier: 'prod' | 'dev'. Env-literal RLS + env CHECK pin it.
  env              String    @default("prod")
  /// Where the completion message may be posted — the completion page's
  /// exact target origin (criterion 28); nothing else may derive it.
  openerOrigin     String
  /// The dev journey's single-use handoff nonce (dev-tier consults only).
  nonce            String?   @unique
  /// Set by the nonce entry's one-shot redemption (portal-side): the
  /// indivisible claim that makes a replayed popup URL refuse after first
  /// use. The row itself survives until claim or expiry — the callback still
  /// redeems it by `state`.
  nonceRedeemedAt  DateTime?
  /// Five-minute TTL — completion at or after this cannot establish a connection.
  expiresAt        DateTime
  /// Set by the helper's acknowledged cancel; a claimed-or-cancelled attempt
  /// can never complete.
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())

  /// The portal sweep's expiry scan.
  @@index([expiresAt])
  @@map("connection_consent_attempts")
}

/// A scoped credential for developing an app against its env=dev partition
/// (dev-mode design §4, Appendix A.3). Minted/rotated/revoked from the portal
/// (owner-gated, control-plane); verified by the step-3 dev-gateway, which hashes
/// the presented bearer and looks up a non-revoked, non-expired row for the
/// request's app, then checks the request Origin against `origins`. Opaque token,
/// stored ONLY as a SHA-256 hash (`tokenHash`) — never re-displayed. `revokedAt`
/// is a soft flip the dev-gateway checks on the hot path (revocation is immediate,
/// §4.1). `env=dev` is implicit: the token can only ever reach the dev tier.
model AppDevToken {
  id           String    @id @default(uuid()) @db.Uuid
  appId        String    @db.Uuid
  app          App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  /// The principal env=dev is keyed by (the minting developer's `actor.oid`,
  /// ADR-0048); also the metering/audit identity in dev.
  developerOid String
  /// SHA-256 hex of the opaque token (prefix included) — the revocable lookup key.
  tokenHash    String    @unique
  /// Exact CORS origins this token may be used from (no wildcards; §4.1).
  origins      String[]
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([appId])
  @@map("app_dev_token")
}
