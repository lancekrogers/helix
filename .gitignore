# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Example apps commit their built dist/ so `helix deploy` works without a build step.
# Re-include after the global dist/ ignore above: un-ignore the directory, then
# its contents (git won't descend into an excluded directory otherwise).
!examples/**/dist/
!examples/**/dist/**

# Examples are standalone projects built with a throwaway local install
# (`pnpm install --ignore-workspace`); their lockfiles aren't tracked.
examples/**/pnpm-lock.yaml

# Generated Prisma client (rebuilt on install via the portal's postinstall)
apps/portal/src/db/generated/

# Offline geolocation database (`pnpm --filter @azx-pbc/portal geo:fetch`, ADR-0050)
apps/portal/geo/

# Env / secrets
.env
.env.*
!.env.example

# Local devcontainer env override (consumed by docker-compose env_file)
.devcontainer/.env.local

# Local mkcert TLS material (generated by post-create.sh; CA key is secret-ish)
.devcontainer/certs/

# Logs / OS
*.log
.DS_Store

# Test / tooling caches
coverage/
.vitest/
playwright-report/
test-results/

.github-issues

# VitePress dev cache (the built dist/ is covered by the global dist/ ignore)
apps/docs/.vitepress/cache/

# Generated docs page — rendered from packages/deploy-skill/SKILL.md by
# apps/docs/scripts/render-skill.ts before every build and dev start
# (ADR-0036 decision 7). The template is the single authored source.
apps/docs/src/apps/quickstart.md
logs_*.zip

# Rule-table copy the local NSG simulation mounts while it runs
infra/netsim/.docker-rules.json
